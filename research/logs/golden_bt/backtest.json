 "rulings": {
  "session": "read_prices_wide(table=daily_bars_adj_v2, session='raw') — 두 창 모두 2026-09-14 애프터마켓 오염 전. 2024~ 는 요청하지 않는다(주 창 끝 2023-12-31, 주식수·실적 원천 행도 창 끝 뒤 as-of 는 쓰지 않는다). 2024~ 보고 열은 내지 않는다(조회하지 않음).",
  "suspension": "정지일(거래량 0·결측) 시가·종가·원 종가 NaN(MQ-2) — 그날 체결 불가, 판정 없음. 매도 대기 중 정지면 다음 체결 가능일 시가. 확률·사전 후보의 MA 는 창에 NaN 이 있으면 NaN 그대로(GB-1 에서도 바꾸지 않음).",
  "gb1_fallback": "정정 GB-1(컨트롤러, 결과 전): 골든 판정은 정지일을 건너뛴 MA50·MA200(유효 종가 마지막 50·200 개 평균, E.valid_ma)으로 한다. 보유 중 그날 판정 신호가 NaN 이면 — 골든 전(P_g NaN): 보유, 손절만. 골든 뒤(dead_p 의 P_d 또는 ma200 설정의 MA200 이 NaN): 종가 < 건너뛴 MA200 → 다음 시가(사유 ma200_fb). 신호가 유한하면 원래 규칙. 거래별 NaN 판정일 수(nan_dec)·대체 청산 수를 보고한다. ma200 설정에도 같은 대체를 쓴다(그 설정의 신호가 정규 MA200 이라 같은 결함). 널 ② 의 골든(추가 매수 정지)도 건너뛴 MA.",
  "pool": "사전 후보 = 유니버스(위생·ADV20 ≥ 10억·상장 252일) ∧ EPS↑ ∧ 0 < 1 − MA50/MA200 ≤ 0.05 ∧ 0 < d = 1 − MA50/종가 ≤ 0.15, 판정일 창 안.",
  "probs": "P_g·P_d = golden_hmm q0 절차 그대로(poly_forecast(y,1,10,0)·σ60·month_pool 3년·원점 ≥ 120·u ≤ t_m−k·모집단 상장 ≥ 70·draw_index(code, 달, 0, 0, 10) M=200) → ma_quad.cross_probs(k=10, 50/200), P_d 는 dead=True(같은 경로·같은 색인, 부등호만 반대). 계산 칸 = 창 안에 사전 후보가 한 번이라도 있었던 종목의 첫 후보일 ~ 창 끝 중 종가 유한 칸(보유 중 판정 전부 포함). 나머지 NaN.",
  "fill": "t 종가 판정 → t+1 시가. 상한가 시가 = 시가 ≥ 전일 종가 × (2015-06-15 전 1.14, 뒤 1.29). 시가 ≤ 손절선이면 사지 않는다. 못 산 주문은 버린다(그날 다른 후보로 채우지 않는다).",
  "sizing_d": "비중의 d 는 체결 시가 기준 d_fill = 1 − 손절선/시가(손실 한도 0.25% 를 실제 진입가로 맞춘다). 사전 후보의 d ≤ 0.15 는 판정일 종가 기준, d_fill 상한으로 따로 거르지 않는다(등록에 없는 거름을 더하지 않는다).",
  "prob_topup": "prob: 기준 = min(5%, 0.25%/d_fill) 진입 때 고정. 골든 전 판정일마다 목표 = 기준 × P_g(t), 현재 = 원가 비중(Σ 매수 금액 ÷ 진입 때 자산 — 정정 GB-2, 시가 평가 비중이면 가격 하락만으로 사는 물타기가 된다), 목표 > 현재면 (차이 × 진입 때 자산)을 다음 시가에 추가(진입과 같은 체결 조건, 현금 한도). 줄이지 않는다. 골든 뒤에는 추가하지 않는다(P_g 가 사실상 1 이 되는 구간 — 보수 쪽). 폴드 진입 마감 뒤에도 보유 포지션의 추가는 규칙대로.",
  "golden": "골든 = 진입 뒤 판정일 종가 기준 MA50 > MA200(엄격)이 처음 된 날. 그날 판정부터 골든 뒤 규칙(dead_p·ma200)이 적용되고 예측 붕괴·추가 매수는 멈춘다. 손절은 앞뒤 모두.",
  "exit_priority": "같은 날 사유가 겹치면 손절 > (골든 전) 붕괴 / (골든 뒤) 데드·MA200 — 붕괴와 데드는 골든 전후로 배타.",
  "nan_prob": "정정 GB-1 그대로: 보유 중 그날 판정 신호가 NaN 이면 골든 전(P_g)은 붕괴 판정 없이 보유(손절만), 골든 뒤(dead_p 의 P_d·ma200 설정의 MA200)는 정지일 건너뛴 MA200 대체 청산(ma200_fb) — 자세한 것은 gb1_fallback.",
  "slots": "슬롯 20 = 보유(매도 대기 포함) 수. 청산으로 빈 슬롯은 체결일 종가 판정부터 쓴다. 순위 P_g 내림차순, 같으면 종목 행 순. 같은 종목 재진입은 청산 체결일 종가 판정부터(다음 시가).",
  "delist": "마지막 유한 종가 뒤(폐지·자료 끝)에는 그 다음 거래일에 마지막 가격으로 청산(사유 delist, 그날 비용).",
  "cost": "korea.cost_rt(청산일, 시장) × 비용 배수(판정 2배)를 매도 대금에서 뺀다 — 재현 창도 같은 함수(그 시기 세율). 시장 = 현재 상장 메타(PIT 아님).",
  "R": "R = 손익 ÷ (0.25% × 첫 매수 금액을 정한 전날 종가 자산). 추가 매수분 손익도 같은 분모.",
  "train_score": "학습 점수 = 학습 창 [2017-10-02, Y−1 말] 만 시뮬(빈 장부): 끝난 거래 + Y−1 마지막 종가 평가 보유분(비용 2배 포함)의 R 합. Y 가격은 엔진에 들어가지 않는다.",
  "oos": "폴드 Y 시험 = 빈 장부, Y 첫 거래일 체결부터 Y 말 체결까지 새 진입, 보유는 진입 설정대로 2023-12-28 종가까지(끝 보유분 비용 포함 평가). 폴드 밖 거래 = 네 폴드 거래를 이어 붙인 것(체결 수·R·바 ①②③⑥).",
  "oos_equity": "정정 GB-1(컨트롤러, 결과 전): 자산 기반 바(④ 팩터 알파·⑤ 연복리·⑦ DSR)와 월 팩터 회귀의 폴드 밖 자산 = 모든 폴드 밖 거래의 (비중 × 그날 수익) 합(거래별 그날 손익 ÷ 첫 매수 때 자산, 청산일 비용 포함)을 2020 첫 거래일 ~ 2023-12-28 에 복리로 이은 것 (W.oof_series) — 폴드 Y 진입은 Y+1 에도 자기 설정대로 기여한다. 총노출 = Σ 보유 가치 ÷ 첫 매수 때 자산(폴드가 겹치면 1 을 넘을 수 있다), 평균·최대를 보고하고 노출 맞춘 시장도 이 노출로. 재현은 단일 시뮬 자산 그대로.",
  "neighbors": "이웃 = 자기 + 한 축만 다른 설정: θ_in 은 순서 축 한 칸(0.3↔0.5↔0.7↔0.9), θ_out·sizing·exit(dead_p 0.5·dead_p 0.7·ma200) 은 범주 축이라 다른 값 전부. 선택 = 이웃 학습 점수 중앙값 최대, 동률이면 메뉴 순서 앞.",
  "null1": "널 ① = 300 회, 회마다 폴드마다 48 중 무작위 설정(복원, 시드 고정) 의 폴드 밖 R 합(비용 2배)을 더한다. 재현은 회마다 설정 하나.",
  "null2": "널 ② = 300 회, 선택 설정의 체결된 진입마다 같은 판정일 같은 풀(사전 후보 ∧ P_g 유한 — P_g 문턱 없음)에서 무작위 종목(그날 안 비복원, 체결 불가면 다음 후보, 풀이 모자라면 모자란 수 기록), 같은 체결·손절(판정일 MA50 고정) 규칙. 정정 GB-2(C1): 비중 = 무작위 종목의 기준 min(5%, 0.25%/d_fill) × 짝 전략 거래의 원가 배수 경로(그날 k 번째 무작위 체결 ↔ 그날 순위 k 번째 전략 거래 — 진입 P_g 내림차순·종목 행). 무작위 쪽 추가 매수는 끄지 않고 같은 배수 경로를 따른다: 전략 거래의 추가 체결일과 같은 '체결 뒤 거래일 수'에 원가가 기준 × 그 누적 배수가 되도록 산다(그날 체결 불가·이미 청산·손절 대기면 없음). eq 는 배수 1(현금 부족 체결이면 그 비율). 무작위 종목 자신의 P_g 는 쓰지 않는다. 보유 기간 = 선택 설정 폴드 밖 거래 중 손절도 끝 절단(end)도 아닌 청산(붕괴·데드·MA200·대체·폐지)의 체결 간 거래일 수 분포에서 복원 추출(정정 GB-2 Minor), 그 날짜 시가 매도(정지면 미룸), 손절이 먼저면 손절. 거래 단위(자산 1 고정, 슬롯·현금 제약 없음).",
  "bar2": "② 진입 연월 군집 복원 추출 2,000 회, 거래 R 평균의 2.5% 분위 > 0(ma_quad_calib.bss_ci 규약).",
  "bar3": "③ 종목별 R 합 상위 5 종목의 거래를 빼고 R 평균 > 0(거래 제거 — 재시뮬 아님).",
  "bar4": "④ 월 수익(첫 달 포함) ~ KOSPI + KOSDAQ + MOM(12-1) + SMB + LV + REV(1개월 반전, 직전 달 수익 하위 30% − 상위 30%) — 팩터는 autoresearch.prepare.factor_months 를 그대로 쓰고 REV 만 같은 규약으로 더한다(prepare.py 는 MANIFEST sha 로 보호돼 고치지 않는다). 'OLS·NW lag 3' 은 둘 다 t > 2 로 읽는다(보수 쪽).",
