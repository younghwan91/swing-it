# 비밀키 — .env.live 등 어떤 접미도 추적하지 않는다(검토 M8). 비밀은 환경변수나 ../quant-airflow/.env 로만.
.env
.env.*

# 데이터 산출물 (SQLite DB, CSV, 차트)
data/
# 스윙 라이브 상태(원장·장부·페이퍼 브로커·로그·정지 파일) — data/ 에 이미 포함되지만 명시한다
data/live_swing/**
data/swing_*STOP
*.db
*.csv
*.png
collect.log

# 일일 리포트 산출물 (scripts/daily_report.sh) — 생성물이지 소스가 아니다
/reports/
# README 커버 이미지는 추적 (재현: scripts/make_figures.py)
!docs/images/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# oh-my-claudecode local session/tool state
.omc/

# BO 생성 산물(과최적 파라미터 — 커밋 안 함). 중첩 경로 포함.
research/**/bo_best_params.json
research/bo_best_params.json

# 에이전트용 레포 복사본 — 커밋 대상이 아니다
.claude/worktrees/
